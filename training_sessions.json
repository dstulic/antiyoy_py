  {
    "timestamp": "2026-07-16T21:03:54.635209+00:00",
    "model_details": "treasury_potential",
    "model_description": "Continues from economy_potential. Folds a slice of the agent's bank balance into the economy potential (economy += treasury_weight*treasury), still per-step/telescoping. Motivation from replay analysis: the previous model was money-blind \u2014 it used expensive units for cheap jobs (a strong unit to clear a tree) and over-built into a bankruptcy spiral (unpaid units -> graves -> trees), because spending/upkeep were only punished by the delayed terminal loss. Now spending drops the potential immediately, so a unit must recoup its cost through territory; idle-army upkeep is felt as a continuous drain; and the bankruptcy path gets an early warning. Aim: emergent cost-efficient unit choice and treasury management, without hard-coding either. treasury_weight is small (~0.1) so productive spending stays net-positive against a per-hex reward of territory_weight/384.",
    "algorithm": "MaskablePPO",
    "hyperparameters": {
      "learning_rate": 0.0003,
      "n_steps": 2048,
      "batch_size": 256,
      "n_epochs": 5,
      "gamma": 0.97,
      "gae_lambda": 0.95,
      "clip_range": 0.2,
      "ent_coef": 0.03,
      "vf_coef": 0.5,
      "territory_weight": 2.0,
      "opponent_weight": 2.0,
      "income_weight": 0.0025,
      "treasury_weight": 0.1,
